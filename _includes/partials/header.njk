  <header id="header" class="fixed-top">
    <div class="container d-flex align-items-center">
      <a class="brand me-auto" href="{{ navPrefix }}#hero" aria-label="{{ t.meta.siteName }}">
        <img src="assets/img/logo.png" alt="{{ t.meta.siteName }}">
      </a>

      <nav id="navbar" class="navbar">
        <ul>
          <li><a class="nav-link scrollto{% if activeNav == 'home' %} active{% endif %}" href="{{ navPrefix }}#hero">{{ t.nav.home }}</a></li>
          <li><a class="nav-link scrollto" href="{{ navPrefix }}#hiring">{{ t.nav.hiring }}</a></li>
          <li><a class="nav-link scrollto" href="{{ navPrefix }}#faq">{{ t.nav.privacy == '隱私權政策' and '常見問題' or 'FAQ' }}</a></li>
          <li><a class="nav-link scrollto" href="{{ navPrefix }}#partners">{{ t.nav.partners }}</a></li>
          <li><a class="nav-link scrollto" href="{{ languageHref }}">{{ t.nav.languageSwitch }}</a></li>
        </ul>
        <i class="bi bi-list mobile-nav-toggle" aria-label="Menu"></i>
      </nav>

      <div class="header-actions">
        <a href="{{ site.discordUrl }}" class="appointment-btn" target="_blank" rel="noopener">{{ t.hero.cta }}</a>
        <a href="{{ site.crewLoginUrl }}" class="crew-login-btn" target="_blank" rel="noopener">{{ t.nav.crewLogin }}</a>
      </div>
    </div>
  </header>
