---
layout: layouts/base.njk
pagination:
  data: site.locales
  size: 1
  alias: pageLocale
permalink: "{{ pageLocale.permalink }}"
navPrefix: ""
activeNav: home
eleventyComputed:
  pageHref: "{{ pageLocale.href }}"
---
  <section id="hero" class="d-flex align-items-center">
    <div class="hero-cover">
      <iframe
        src="{{ site.heroVideoEmbedUrl | safe }}"
        title="{{ t.hero.title }}"
        loading="eager"
        allow="autoplay; encrypted-media; picture-in-picture"
        allowfullscreen
      ></iframe>
      <div class="mask"></div>
    </div>
    <div class="container hero-content">
      <p class="hero-kicker">China Airlines Virtual</p>
      <h1>{{ t.hero.title }}</h1>
      <h2>{{ t.hero.subtitle }}</h2>
      <a href="{{ site.discordUrl }}" class="btn-get-started" target="_blank" rel="noopener">{{ t.hero.cta }}</a>
    </div>
  </section>

  <main id="main">

    <!-- ======= Why Us Section ======= -->
    <section id="why-us" class="why-us">
      <div class="container">

        <div class="row">
          <div class="col-lg-4 d-flex align-items-stretch">
            <div class="content">
              <h3>{{ t.whyUs.heading }}</h3>
              <p>
                {{ t.whyUs.bodyHtml | safe }}
              </p>
              <h4>{{ t.whyUs.welcome }}</h4>
              <div class="text-center">
                <a href="{{ site.discordUrl }}" class="more-btn">{{ t.whyUs.cta }} <i class="bx bx-chevron-right"></i></a>
              </div>
            </div>
          </div>
          <div class="col-lg-8 d-flex align-items-stretch">
            <div class="icon-boxes d-flex flex-column justify-content-center">
              <div class="row">
                {%- for box in t.whyUs.boxes %}
                <div class="col-xl-4 d-flex align-items-stretch">
                  <div class="icon-box mt-4 mt-xl-0">
                    <i class="{{ box.icon }}"></i>
                    <h4>{{ box.title }}</h4>
                    <p>{{ box.text }}</p>
                  </div>
                </div>
                {%- endfor %}
              </div>
            </div><!-- End .content-->
          </div>
        </div>

      </div>
    </section><!-- End Why Us Section -->


    <!-- ======= About Section ======= -->
    <section id="hiring" class="about feature-section">
      <div class="container">
        <div class="feature-shell">
          <div class="feature-media">
            <a href="{{ site.introVideoUrl }}" class="glightbox feature-play" aria-label="Play introduction"></a>
          </div>

          <div class="feature-content">
            <p class="feature-eyebrow">Community</p>
            <h3>{{ t.hiring.heading }}</h3>
            <p class="feature-intro">{{ t.hiring.intro }}</p>
            <div class="feature-grid">
              {% for box in t.hiring.boxes %}
              <a class="feature-card" href="{% if box.link == 'discord' %}{{ site.discordUrl }}{% elif box.link == 'facebook' %}{{ site.facebookUrl }}{% else %}{{ site.instagramUrl }}{% endif %}" target="_blank" rel="noopener">
                <span class="feature-icon"><i class="{{ box.icon }}"></i></span>
                <span>
                  <h4>{{ box.title }}</h4>
                  <p>{{ box.text }}</p>
                </span>
                <i class="bx bx-right-arrow-alt feature-arrow"></i>
              </a>
              {% endfor %}
            </div>
          </div>
        </div>

        <div class="dispatch-block">
          <div class="dispatch-heading">
            <p class="feature-eyebrow">Operations</p>
            <h3>{{ t.dispatch.heading }}</h3>
            <p>{{ t.dispatch.intro }}</p>
          </div>
          <div class="dispatch-layout">
            <div class="dispatch-grid">
            {% for box in t.dispatch.boxes %}
            <article class="dispatch-card">
              <span class="feature-icon"><i class="{{ box.icon }}"></i></span>
              <h4>{{ box.title }}</h4>
              <p>{{ box.text }}</p>
            </article>
            {% endfor %}
            </div>
            <div class="dispatch-media">
              <img src="assets/img/dispatch-intro.jpg" alt="{{ t.dispatch.heading }}" loading="lazy" decoding="async">
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- ======= Frequently Asked Questions Section ======= -->
    <section id="faq" class="faq section-bg">
      <div class="container">

        <div class="section-title">
          <h2>{{ t.faq.heading }}</h2>
        </div>

        <div class="faq-list">
          <ul>
            {%- for item in t.faq.items %}
            <li data-aos="fade-up"{% if not loop.first %} data-aos-delay="{{ loop.index0 * 100 }}"{% endif %}>
              <i class="bx bx-help-circle icon-help"></i> <a data-bs-toggle="collapse"
                class="{% if loop.first %}collapse{% else %}collapsed{% endif %}"
                data-bs-target="#faq-list-{{ loop.index }}">{{ item.question }} <i class="bx bx-chevron-down icon-show"></i><i
                  class="bx bx-chevron-up icon-close"></i></a>
              <div id="faq-list-{{ loop.index }}" class="collapse{% if loop.first %} show{% endif %}" data-bs-parent=".faq-list">
                <p>
                  {{ item.answerHtml | safe }}
                </p>
              </div>
            </li>
            {%- endfor %}
          </ul>
        </div>

      </div>
    </section><!-- End Frequently Asked Questions Section -->

    <!-- ======= Partners Section ======= -->
    <section id="partners" class="partners-section">
      <div class="container">
        <div class="partners-heading">
          <p class="feature-eyebrow">Network</p>
          <h2>{{ t.partners.heading }}</h2>
        </div>

        <div class="partner-wall">
          {%- for partner in site.partners %}
          <a class="partner-brand" href="{{ partner.href }}" target="_blank" rel="noopener">
            <span class="partner-logo">
              <img src="{{ partner.img }}" alt="{{ partner.key }}" loading="lazy" decoding="async">
            </span>
            <span class="partner-info">
              <span>{{ t.partners.items[partner.key] }}</span>
              <i class="bx bx-right-arrow-alt"></i>
            </span>
          </a>
          {%- endfor %}
        </div>
      </div>
    </section>

{% include "partials/privacy.njk" %}

  </main><!-- End #main -->
