---
layout: layouts/base.njk
locale: zh-TW
pagination:
  data: flightData.all
  size: 1
  alias: flight
permalink: "flight-history-{{ flight.id }}.html"
navPrefix: "/"
activeNav: flightHistory
privacyPaddingTop: 100px
eleventyComputed:
  pageTitle: "{{ flight.title[localeCode] }} | {{ t.meta.title }}"
  pageHref: "/flight-history-{{ flight.id }}.html"
---
<main>
  <section id="flight-history-text" class="departments" style="padding-top: 200px">
    <div class="container">

      <div class="section-title">
        <h2>{{ t.flightHistory.detailHeading }}</h2>
      </div>

      <div class="row gy-4">
        <div class="col-lg-12">
          {%- if flight.image %}
          <img src="{{ flight.image }}" width="100%">
          {%- endif %}
          {%- for line in flight.lines[localeCode] %}
          {{ line }}<br>
          {%- endfor %}
        </div>
      </div>
    </div>
  </section>

  <!-- ======= Flight History Section ======= -->
  <section id="flight-history" class="departments" style="padding-top: 50px">
    <div class="container">

      <div class="section-title">
        <h2>{{ t.flightHistory.recordHeading }}</h2>
      </div>

      <div class="row gy-4">
        <div class="col-lg-12">
          <h3>{{ flight.date | slashDate }} {{ t.flightHistory.recordSuffix }}</h3>
          <div id="map-replay" style="min-height: 600px" data-timeline="{{ flight.timeline }}" data-lat="{{ flight.map.lat }}" data-lon="{{ flight.map.lon }}" data-zoom="{{ flight.map.zoom }}"></div>
        </div>
      </div>
    </div>
  </section>

  {%- set others = [] %}
  {%- for other in flightData.listed %}
  {%- if other.id != flight.id %}{% set others = (others.push(other), others) %}{% endif %}
  {%- endfor %}
  {%- if others.length %}
  <!-- ======= Other Flights Section ======= -->
  <section id="other-flight" class="departments" style="padding-top: 50px">
    <div class="container">

      <div class="section-title">
        <h2>{{ t.flightHistory.otherHeading }}</h2>
      </div>

      <div class="row gy-4">
        <div class="col-lg-12">
          {%- for other in others %}
          <a href="flight-history-{{ other.id }}.html" class="btn btn-outline-primary">{{ other.title[localeCode] }}</a>
          {%- endfor %}
        </div>
      </div>
    </div>
  </section>
  {%- endif %}

{% include "partials/privacy.njk" %}

</main><!-- End #main -->
